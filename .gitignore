# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Netlify folder
.netlify

# graphify: per-rebuild artifacts, not the graph itself.
# The graph (graph.json, graph.html, GRAPH_REPORT.md, GRAPH_INDEX.md, manifest.json,
# cache/) stays tracked — these are the churn the post-commit hook generates.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/converted/
graphify-out/.graphify_incremental.json
graphify-out/.graphify_detect.json
