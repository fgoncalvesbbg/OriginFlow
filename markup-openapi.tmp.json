<!-- Global site tag (gtag.js) - Google Analytics -->
<script>
    (function () {
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        const loadGA = () => {
            const gtm = document.createElement("script");
            gtm.async = true;
            gtm.src = "https://www.googletagmanager.com/gtag/js?id=" + markupEnv.GA_MEASUREMENT_ID;
            document.head.append(gtm);
            gtag("js", new Date());
            gtag("config", markupEnv.GA_MEASUREMENT_ID);
        };

        // keep this in sync with ./gtm.html and NOT_ALLOWED_PATH_PATTERNS in
        // packages/website/src/service/tracker/tracker-service.ts
        const NOT_ALLOWED_PATHS = ["password/forgot", "invite/accept"];

        if (!NOT_ALLOWED_PATHS.some((path) => window.location.pathname.includes(path))) {
            loadGA();
        }
    })();
</script>
<!-- End Google Analytics -->
<!-- Global site tag (gtm.js) - Google Tag Manager -->
<script>
    (function () {
        const loadGTM = function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({
                "gtm.start": new Date().getTime(),
                "event": "gtm.js"
            });
            var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
        };
        
        // keep this in sync with ./ga.html and with NOT_ALLOWED_PATH_PATTERNS in
        // packages/website/src/service/tracker/tracker-service.ts
        const NOT_ALLOWED_PATHS = ["password/forgot", "invite/accept"];

        if (!NOT_ALLOWED_PATHS.some((path) => window.location.pathname.includes(path))) {
            loadGTM(window, document, "script", "dataLayer", markupEnv.GTM_CONTAINER_ID);
        }
    })();
</script>
<!-- End Google Tag Manager -->
