{"nodes": [{"id": "design_design_system_originflow_plm", "label": "OriginFlow PLM Design System (DESIGN.md)", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_control_room", "label": "The Control Room (Creative North Star)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The room a PM runs many launches from: calm dark navigation rail framing a bright uncluttered canvas; color spent almost entirely on state and the single accent; personality is calm, precise, trustworthy."}, {"id": "design_steel_slate_accent", "label": "Steel Slate Accent (#3f5b73)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one accent, reserved for action/selection/active state; a muted corporate blue-gray chosen over saturated indigo for a calmer feel; Tailwind indigo-*/blue-* scales remapped onto this steel ramp in index.html."}, {"id": "design_status_badges", "label": "Status Badges (signature four-hue vocabulary)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tinted pills in four families (steel/indigo, emerald, rose, gray) pairing hue with a text label; consistent status vocabulary used everywhere."}, {"id": "design_the_rail", "label": "The Rail (fixed dark navigation)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed 16rem dark rail (Control-Room Ink #1a1f35); active item = Action Steel fill; hidden below md and collapsed to top-bar affordance on mobile."}, {"id": "design_inter_typography", "label": "Inter-only Typography System", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One well-tuned grotesque (Inter) doing everything; hierarchy from weight and size contrast; Headline/Title/Body/Label ramp; a UI with many labels reads calmer with one voice."}, {"id": "design_elevation", "label": "Layered Elevation System", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layered not flat: rest -> sticky -> rail -> overlay; shadows are structural and paired with hairline borders; cards <=16px radius."}, {"id": "design_state_not_decoration_rule", "label": "State-Not-Decoration Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saturated color is earned by meaning: it carries a status or marks action/selection, otherwise it is gray. No color placed for flavor."}, {"id": "design_color_plus_shape_rule", "label": "Color-Plus-Shape Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status is never conveyed by color alone; every status pill pairs hue with a text label so states are distinguishable without color vision."}, {"id": "design_one_voice_rule", "label": "One-Voice Rule (Inter only)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No display serif, no second sans; if a screen feels like it needs a second typeface it needs better weight/size hierarchy instead."}, {"id": "design_design_tokens", "label": "Design Tokens (colors, spacing, radii)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Near-neutral palette (Control-Room Ink, Action Steel, semantic state hues), 4/8/16/24 spacing, radii sm 4 / md 8 / lg 12 / full."}], "edges": [{"source": "design_design_system_originflow_plm", "target": "design_control_room", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_control_room", "target": "design_design_system_originflow_plm", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_design_system_originflow_plm", "target": "design_steel_slate_accent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_design_system_originflow_plm", "target": "design_status_badges", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_design_system_originflow_plm", "target": "design_the_rail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_design_system_originflow_plm", "target": "design_inter_typography", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_design_system_originflow_plm", "target": "design_elevation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_design_system_originflow_plm", "target": "desi